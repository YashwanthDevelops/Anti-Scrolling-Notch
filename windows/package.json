{
  "name": "anti-scrolling-notch-windows",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test:capabilities": "node --test tests/capability-guard.test.mjs",
    "test:shell": "node --experimental-strip-types --test --test-concurrency=1 tests/island-fsm.test.mjs tests/motion.test.mjs tests/sequence.test.mjs",
    "test:view-store": "node --test tests/view-store.test.mjs",
    "test:bridge-errors": "node --test tests/bridge-errors.test.mjs",
    "test:architecture": "node --test tests/architecture-boundary.test.mjs",
    "preview": "vite preview",
    "icons": "node scripts/gen-icons.mjs",
    "tauri": "tauri",
    "predev": "cargo build --release -p anti-scrolling-notch-hook",
    "prebuild": "cargo build --release -p anti-scrolling-notch-hook",
    "test:identity": "node scripts/check-runtime-identity.mjs",
    "test:resources": "node --test tests/resource-set.test.mjs",
    "pack": "tauri build && node scripts/pack.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "^5.6.0",
    "vite": "^6"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  }
}
